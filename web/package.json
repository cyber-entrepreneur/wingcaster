{
  "name": "wingcaster-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "start": "cd ../backend && npm start",
    "dev": "vite --port 7100",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "preflight:fast": "node scripts/preflight.mjs --fast",
    "preview": "vite preview",
    "server": "node ../backend/src/server.js",
    "start:backend": "node ../backend/src/server.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "migrate": "node ../backend/scripts/migrate-from-json.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --report-unused-disable-directives",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,css,json,md}\"",
    "mobile:build": "npm run build && cap sync",
    "mobile:sync": "cap sync",
    "mobile:sync:ios": "cap sync ios",
    "mobile:sync:android": "cap sync android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:run:ios": "cap run ios",
    "mobile:run:android": "cap run android",
    "mobile:doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "6.0.1",
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@sentry/react": "10.74.0",
    "@sentry/vite-plugin": "5.4.0",
    "@simplewebauthn/browser": "^10.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "idb": "8.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.400.0",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-email-editor": "^2.1.2",
    "react-grid-layout": "^2.2.4",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest-axe": "^3.5.9",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fake-indexeddb": "6.2.5",
    "globals": "^15.8.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.17.0",
    "vite": "^5.3.4",
    "vitest": "^2.0.4"
  }
}
