<div class="min-h-screen bg-[var(--lc-bg-page)] px-4 py-8 sm:px-6" data-testid="bad-comparable-report-page" dir="ltr"><div class="mx-auto max-w-[680px]"><header class="mb-[var(--lc-space-lg)]"><h1 class="text-[length:var(--lc-type-heading-1)] text-[var(--lc-text-heading)]">Report a bad comparable</h1></header><form class="space-y-[var(--lc-space-lg)]" novalidate=""><section aria-label="Comparable being reported"><div class="block w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border)] bg-[var(--lc-surface-sunken)] p-[var(--lc-space-md)] text-start no-underline" role="group" aria-label="Apt 2405"><div class="flex items-start gap-[var(--lc-space-sm)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2 mt-0.5 h-5 w-5 shrink-0 text-[var(--lc-text-muted)]" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[length:var(--lc-type-heading-3)] text-[var(--lc-text-heading)]">Apt 2405</p></div></div></div></section><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="bcr-comparable-id">Comparable ID</label><input class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" id="bcr-comparable-id" placeholder="cmp_… or listing id" required="" value="cmp_1"></div><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="bcr-comparable-type">Comparable type</label><select id="bcr-comparable-type" class="min-h-tap w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] px-3 text-sm text-[var(--lc-text-primary)]"><option value="internal">internal</option><option value="external">external</option><option value="agent_report">agent_report</option></select></div><fieldset class="space-y-[var(--lc-space-sm)]"><legend class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">Why are you reporting this?</legend><div role="radiogroup" aria-label="Why are you reporting this?" class="grid grid-cols-2 gap-[var(--lc-space-sm)] md:grid-cols-3"><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-incorrect_price" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Wrong price</span><span id="bcr-reason-help-incorrect_price" class="text-xs text-[var(--lc-text-muted)]">The listed price doesn't match reality.</span></button><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-wrong_details" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ruler h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path><path d="m14.5 12.5 2-2"></path><path d="m11.5 9.5 2-2"></path><path d="m8.5 6.5 2-2"></path><path d="m17.5 15.5 2-2"></path></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Wrong area</span><span id="bcr-reason-help-wrong_details" class="text-xs text-[var(--lc-text-muted)]">Size, bedrooms, or bathrooms are wrong.</span></button><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-already_sold" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Already sold</span><span id="bcr-reason-help-already_sold" class="text-xs text-[var(--lc-text-muted)]">This property is off the market.</span></button><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-fake_listing" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Spam or fake</span><span id="bcr-reason-help-fake_listing" class="text-xs text-[var(--lc-text-muted)]">Not a real listing.</span></button><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-other" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Something else</span><span id="bcr-reason-help-other" class="text-xs text-[var(--lc-text-muted)]">Tell PA what you saw.</span></button></div></fieldset><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="bcr-notes">Tell PA what happened</label><textarea id="bcr-notes" rows="4" maxlength="1050" placeholder="Share what you saw. Kind and specific beats terse." class="w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] px-3 py-2 text-sm text-[var(--lc-text-primary)]" aria-describedby="bcr-notes-hint"></textarea><div class="flex items-start justify-between gap-2"><p id="bcr-notes-hint" class="text-xs text-[var(--lc-text-muted)]"></p><p class="text-end text-[length:var(--lc-type-caption)] text-[var(--lc-text-muted)]" aria-hidden="true"><span data-lc-numeric="true" class="lc-data">0</span> / <span data-lc-numeric="true" class="lc-data">1000</span></p></div></div><div class="flex flex-col gap-[var(--lc-space-sm)]"><label for=":r0:" class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">Evidence (optional, up to 3 files)</label><p class="text-sm text-[var(--lc-text-muted)]">Screenshots or PDFs make PA's job faster.</p><ul role="list" class="grid gap-[var(--lc-space-sm)] grid-cols-[repeat(auto-fill,minmax(96px,1fr))] md:grid-cols-[repeat(auto-fill,minmax(120px,1fr))]"><li><button type="button" id="__stable__" class="flex aspect-square w-full flex-col items-center justify-center gap-1 rounded-[var(--lc-radius-md)] border border-dashed border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] text-[var(--lc-text-muted)] hover:bg-[var(--lc-action-secondary)] focus-visible:outline-none min-h-tap" aria-label="Add evidence file"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-5 w-5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span class="text-xs">Add</span></button></li></ul><input type="file" class="sr-only" accept="image/jpeg,image/png,image/heic,application/pdf,text/csv" multiple="" tabindex="-1" aria-hidden="true"><div class="sr-only" aria-live="polite"