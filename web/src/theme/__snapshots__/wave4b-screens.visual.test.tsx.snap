le:outline-none disabled:cursor-not-allowed disabled:opacity-50" value="7"><input type="text" inputmode="numeric" autocomplete="off" maxlength="6" aria-label="Digit 4 of 6" class="h-12 w-10 text-center font-[family-name:var(--lc-font-mono)] text-[length:var(--lc-type-heading-3)] tabular-nums sm:h-14 sm:w-12 rounded-[var(--lc-radius-md)] border-2 bg-[var(--lc-surface-raised)] text-[var(--lc-text-primary)] border-[var(--lc-border-strong)] focus-visible:border-[var(--lc-action-primary)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" value="2"><input type="text" inputmode="numeric" autocomplete="off" maxlength="6" aria-label="Digit 5 of 6" class="h-12 w-10 text-center font-[family-name:var(--lc-font-mono)] text-[length:var(--lc-type-heading-3)] tabular-nums sm:h-14 sm:w-12 rounded-[var(--lc-radius-md)] border-2 bg-[var(--lc-surface-raised)] text-[var(--lc-text-primary)] border-[var(--lc-border-strong)] focus-visible:border-[var(--lc-action-primary)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" value="9"><input type="text" inputmode="numeric" autocomplete="off" maxlength="6" aria-label="Digit 6 of 6" class="h-12 w-10 text-center font-[family-name:var(--lc-font-mono)] text-[length:var(--lc-type-heading-3)] tabular-nums sm:h-14 sm:w-12 rounded-[var(--lc-radius-md)] border-2 bg-[var(--lc-surface-raised)] text-[var(--lc-text-primary)] border-[var(--lc-border-strong)] focus-visible:border-[var(--lc-action-primary)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" value="1"></div><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 w-full" type="button">Verify</button><div class="flex flex-wrap gap-[var(--lc-space-sm)]"><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-brand)] underline-offset-4 hover:text-[var(--lc-action-primary-hover)] hover:underline min-h-tap px-4 py-2" type="button">Use a backup code instead</button><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-brand)] underline-offset-4 hover:text-[var(--lc-action-primary-hover)] hover:underline min-h-tap px-4 py-2" type="button">Sign in as different user</button></div><p class="text-center font-[family-name:var(--lc-font-ui)] text-[length:var(--lc-type-caption)] tracking-[var(--lc-tracking-caption)] text-[var(--lc-text-muted)]">This code protects your account. It changes every 30 seconds.</p></div><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-toast flex max-w-[420px] flex-col gap-2 p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div>
