nter justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-brand)] underline-offset-4 hover:text-[var(--lc-action-primary-hover)] hover:underline min-h-tap px-4 py-2" type="button">Try my authenticator code instead</button><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-brand)] underline-offset-4 hover:text-[var(--lc-action-primary-hover)] hover:underline min-h-tap px-4 py-2" type="button">I've lost my codes too — recover my account</button></div><p class="text-center font-[family-name:var(--lc-font-ui)] text-[length:var(--lc-type-caption)] tracking-[var(--lc-tracking-caption)] text-[var(--lc-text-muted)]">Backup codes are one-time only. Once you use one, it's gone.</p></div><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-toast flex max-w-[420px] flex-col gap-2 p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div>
