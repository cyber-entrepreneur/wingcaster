<nav role="tablist" aria-label="Primary navigation" dir="ltr" data-testid="agent-bottom-tab-bar" class="fixed inset-x-0 bottom-0 z-sticky flex w-full border-t border-[var(--lc-border)] bg-[var(--lc-surface-raised)] md:hidden pb-[env(safe-area-inset-bottom,0px)]" style="box-shadow: 0 -2px 0 0 color-mix(in srgb, var(--lc-surface-inverse) 10%, transparent);"><div class="flex h-14 w-full items-stretch"><button type="button" role="tab" id="bottom-tab-dashboard" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard h-6 w-6" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">Dashboard</span></button><button type="button" role="tab" id="bottom-tab-listings" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house h-6 w-6" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">Listings</span></button><button type="button" role="tab" id="bottom-tab-inbox" aria-selected="true" aria-current="page" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] text-[var(--lc-action-primary)] font-semibold active:text-[var(--lc-action-primary-hover)]"><span aria-hidden="true" class="absolute inset-x-0 top-0 mx-auto h-0.5 w-5 rounded-pill bg-[var(--lc-action-primary)]"></span><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square h-6 w-6" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg><span aria-hidden="true" class="pointer-events-none absolute -end-1.5 -top-1.5 inline-flex min-h-[16px] min-w-[16px] items-center justify-center rounded-pill bg-[var(--lc-action-primary)] px-1 text-[10px] font-semibold leading-none text-[var(--lc-action-primary-text)]"><span data-lc-numeric="true" class="lc-data">12</span></span></span><span class="max-w-full truncate font-semibold text-[var(--lc-action-primary)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 600;">Inbox</span><span class="sr-only">Currently on Inbox</span><span class="sr-only">12 unread messages</span></button><button type="button" role="tab" id="bottom-tab-contacts" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-6 w-6" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg><span aria-hidden="true" class="pointer-events-none absolute -end-1.5 -top-1.5 inline-flex min-h-[16px] min-w-[16px] items-center justify-center rounded-pill bg-[var(--lc-action-primary)] px-1 text-[10px] font-semibold leading-none text-[var(--lc-action-primary-text)]"><span data-lc-numeric="true" class="lc-data">3</span></span></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">Contacts</span><span class="sr-only">3 contacts need attention</span></button><button type="button" role="tab" id="bottom-tab-more" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-6 w-6" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg><span aria-hidden="true" class="pointer-events-none absolute -end-1.5 -top-1.5 h-2 w-2 rounded-pill bg-[var(--lc-status-underOffer-dot)]"></span></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">More</span><span class="sr-only">MFA not enrolled</span></button></div></nav><main id="main-content">Content goes here</main><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-toast flex max-w-[420px] flex-col gap-2 p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div>
<!-- portals -->
"
`;

