exports[`Wave 0 visual matrix — LTR/RTL × light/dark > bottom-tab-99plus · dark · ltr 1`] = `
"<!-- mode=light dir=ltr lang=en -->
<nav role="tablist" aria-label="Primary navigation" dir="ltr" data-testid="agent-bottom-tab-bar" class="fixed inset-x-0 bottom-0 z-sticky flex w-full border-t border-[var(--lc-border)] bg-[var(--lc-surface-raised)] md:hidden pb-[env(safe-area-inset-bottom,0px)]" style="box-shadow: 0 -2px 0 0 color-mix(in srgb, var(--lc-surface-inverse) 10%, transparent);"><div class="flex h-14 w-full items-stretch"><button type="button" role="tab" id="bottom-tab-dashboard" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard h-6 w-6" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">Dashboard</span></button><button type="button" role="tab" id="bottom-tab-listings" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6