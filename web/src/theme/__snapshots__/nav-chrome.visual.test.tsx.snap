cate font-semibold text-[var(--lc-action-primary)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 600;">Inbox</span><span class="sr-only">Currently on Inbox</span><span class="sr-only">99+ unread messages</span></button><button type="button" role="tab" id="bottom-tab-contacts" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-6 w-6" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">Contacts</span></button><button type="button" role="tab" id="bottom-tab-more" aria-selected="false" class="relative flex min-h-[var(--lc-tap-target-min)] min-w-[var(--lc-tap-target-min)] flex-1 flex-col items-center justify-center gap-[var(--lc-space-3xs)] px-1 pt-1 text-[var(--lc-text-muted)] transition-[color] duration-[100ms] ease-out hover:text-[var(--lc-action-primary-hover)] active:text-[var(--lc-action-primary-hover)]"><span class="relative inline-flex h-6 w-6 items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu h-6 w-6" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></span><span class="max-w-full truncate font-medium text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption); font-size: 11px; line-height: 14px; font-weight: 500;">More</span></button></div></nav><main id="main-content">Content goes here</main><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-toast flex max-w-[420px] flex-col gap-2 p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div>
