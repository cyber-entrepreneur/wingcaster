/* Base — the only global rules the theme owns. */
html { color-scheme: light dark; }
body {
  margin: 0;
  background: var(--lc-bg-page);
  color: var(--lc-text-primary);
  font: var(--lc-type-body);
  -webkit-font-smoothing: antialiased;
  transition: background var(--lc-duration-base) var(--lc-easing-in-out), color var(--lc-duration-base) var(--lc-easing-in-out);
}
a { color: var(--lc-text-brand); text-decoration: none; }
a:hover { color: var(--lc-action-primary-hover); text-decoration: underline; }
/* Two-tone focus ring. No single colour clears 3:1 against BOTH the page and the orange
   primary button, so the ring pairs an inner and an outer band — one of them always contrasts,
   whatever the element sits on. Do not collapse this to a single outline. */
:where(button, a, [role="button"], input, select, textarea):focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
}
@supports not (selector(:focus-visible)) {
  :where(button, a, [role="button"], input, select, textarea):focus {
    box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
  }
}
:where(button, a[role="button"], [role="button"]) { min-height: var(--lc-tap-target-min); }
/* Numerals are tabular everywhere — prices and counts must not jitter between rows. */
:where(.lc-data, [data-lc-numeric]) { font-family: var(--lc-font-mono); font-variant-numeric: tabular-nums; }
</style></head><body><div><div class="min-h-screen bg-[var(--lc-bg-page)] text-[var(--lc-text-primary)]"><div role="status" class="border-b border-[var(--lc-border)] bg-[var(--lc-status-warning-bg)] px-4 py-2 text-center text-sm text-[var(--lc-status-warning-fg)] lg:hidden">PA console requires a desktop screen (1024px or wider).</div><div class="mx-auto max-w-[1440px] px-[var(--lc-space-xl)] py-[var(--lc-space-xl)]"><header class="mb-[var(--lc-space-lg)] flex flex-wrap items-start justify-between gap-4"><div><h1 class="text-[var(--lc-text-heading)]" style="font: var(--lc-type-heading-1);">Agent-price-report review</h1><p class="mt-1 text-[var(--lc-text-muted)]" style="font: var(--lc-type-body-sm);"><span data-lc-numeric="true" class="lc-data">1</span> pending · <span data-lc-numeric="true" class="lc-data">1</span> high-delta (≥10%) · <span data-lc-numeric="true" class="lc-data">12</span> incorporated · <span data-lc-numeric="true" class="lc-data">21</span> signal-only · <span data-lc-numeric="true" class="lc-data">4</span> rejected this month</p></div><div class="flex flex-wrap items-center gap-2"><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw me-1 h-4 w-4" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d=