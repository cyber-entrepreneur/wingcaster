ibedby="bcr-reason-help-fake_listing" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Spam or fake</span><span id="bcr-reason-help-fake_listing" class="text-xs text-[var(--lc-text-muted)]">Not a real listing.</span></button><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-other" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Something else</span><span id="bcr-reason-help-other" class="text-xs text-[var(--lc-text-muted)]">Tell PA what you saw.</span></button></div></fieldset><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="bcr-notes">Tell PA what happened</label><textarea id="bcr-notes" rows="4" maxlength="1050" placeholder="Share what you saw. Kind and specific beats terse." class="w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] px-3 py-2 text-sm text-[var(--lc-text-primary)]" aria-describedby="bcr-notes-hint"></textarea><div class="flex items-start justify-between gap-2"><p id="bcr-notes-hint" class="text-xs text-[var(--lc-text-muted)]"></p><p class="text-end text-[length:var(--lc-type-caption)] text-[var(--lc-text-muted)]" aria-hidden="true"><span data-lc-numeric="true" class="lc-data">0</span> / <span data-lc-numeric="true" class="lc-data">1000</span></p></div></div><div class="flex flex-col gap-[var(--lc-space-sm)]"><label for=":r7:" class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">Evidence (optional, up to 3 files)</label><p class="text-sm text-[var(--lc-text-muted)]">Screenshots or PDFs make PA's job faster.</p><ul role="list" class="grid gap-[var(--lc-space-sm)] grid-cols-[repeat(auto-fill,minmax(96px,1fr))] md:grid-cols-[repeat(auto-fill,minmax(120px,1fr))]"><li><button type="button" id=":r7:" class="flex aspect-square w-full flex-col items-center justify-center gap-1 rounded-[var(--lc-radius-md)] border border-dashed border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] text-[var(--lc-text-muted)] hover:bg-[var(--lc-action-secondary)] focus-visible:outline-none min-h-tap" aria-label="Add evidence file"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus h-5 w-5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><span class="text-xs">Add</span></button></li></ul><input type="file" class="sr-only" accept="image/jpeg,image/png,image/webp,application/pdf" multiple="" tabindex="-1" aria-hidden="true"><div class="sr-only" aria-live="polite"></div></div><fieldset class="space-y-[var(--lc-space-sm)]"><legend class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">How confident are you?</legend><div role="radiogroup" aria-label="How confident are you?" class="flex max-w-[360px] overflow-hidden rounded-[var(--lc-radius-pill)] border border-[var(--lc-border)] bg-[var(--lc-surface-sunken)]"><button type="button" role="radio" aria-checked="true" class="min-h-tap flex-1 px-2 text-xs transition-colors duration-fast bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)]">I saw this myself</button><button type="button" role="radio" aria-checked="false" class="min-h-tap flex-1 px-2 text-xs transition-colors duration-fast text-[var(--lc-text-primary)]">Colleague told me</button><button type="button" role="radio" aria-checked="false" class="min-h-tap flex-1 px-2 text-xs transition-colors duration-fast text-[var(--lc-text-primary)]">I have hard evidence</button></div></fieldset><div class="sticky bottom-0 flex flex-col-reverse gap-[var(--lc-space-sm)] border-t border-[var(--lc-border)] bg-[var(--lc-surface-raised)] py-[var(--lc-space-md)] shadow-[var(--lc-elevation-sm)] sm:flex-row sm:items-center sm:justify-end"><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap px-4 py-2 min-h-tap" type="button">Cancel</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 min-h-tap sm:max-w-[240px] sm:flex-none" type="submit" disabled="" aria-describedby="bcr-submit-hint">Submit report</button><span id="bcr-submit-hint" class="sr-only">Submit disabled: Pick a reason first.</span></div></form></div></div></div></body></html>"
`;

exports[`APR-004 submit light ltr desktop > snapshot 1`] = `
"<!-- mode=light dir=ltr lang=en viewport=1280px -->
<html data-lc-mode="light" style="color-scheme: light;" dir="ltr" lang="en" data-viewport="desktop"><head><style id="broadcast-theme-css">/* ListingClarion — Broadcast (adopted theme)
   Generated from broadcast-tokens.json. Do not hand-edit: change tokens.js and regenerate.
   Components read only these semantic variables, never a raw hex.
   Light is the default; dark applies via [data-lc-mode="dark"] or prefers-color-scheme.

   Display tokens carry weight 800 — the shorthand already includes it, so
   \`font: var(--lc-type-display)\` renders at the theme's display weight with no extra rule. */

:root {
  --lc-radius-sm: 3px;
  --lc-radius-md: 5px;
  --lc-radius-lg: 7px;
  --lc-radius-xl: 10px;
  --lc-radius-pill: 999px;
  --lc-space-3xs: 2px;
  --lc-space-2xs: 4px;
  --lc-space-xs: 8px;
  --lc-space-sm: 12px;
  --lc-space-md: 16px;
  --lc-space-lg: 20px;
  --lc-space-xl: 24px;
  --lc-space-2xl: 32px;
  --lc-space-3xl: 40px;
  --lc-space-4xl: 48px;
  --lc-space-5xl: 64px;
  --lc-font-display: Archivo, system-ui, sans-serif;
  --lc-font-ui: "IBM Plex Sans", "IBM Plex Sans Arabic", Tahoma, "Segoe UI", system-ui, sans-serif;
  --lc-font-mono: "IBM Plex Mono", ui-monospace, monospace;
  --lc-display-weight: 800;
  --lc-display-tracking: -0.03em;
  --lc-type-display-xl: 800 40px/44px var(--lc-font-display);
  --lc-type-display: 800 32px/38px var(--lc-font-display);
  --lc-type-heading-1: 600 26px/32px var(--lc-font-ui);
  --lc-type-heading-2: 600 21px/28px var(--lc-font-ui);
  --lc-type-heading-3: 600 18px/24px var(--lc-font-ui);
  --lc-type-body-lg: 400 16px/24px var(--lc-font-ui);
  --lc-type-body: 400 15px/22px var(--lc-font-ui);
  --lc-type-body-sm: 400 13px/18px var(--lc-font-ui);
  --lc-type-caption: 500 12px/16px var(--lc-font-ui);
  --lc-type-overline: 600 11px/14px var(--lc-font-ui);
  --lc-type-data: 500 15px/20px var(--lc-font-mono);
  --lc-type-data-sm: 500 13px/18px var(--lc-font-mono);
  --lc-tracking-display-xl: -0.03em;
  --lc-tracking-display: -0.03em;
  --lc-tracking-heading-1: -0.015em;
  --lc-tracking-heading-2: -0.01em;
  --lc-tracking-heading-3: -0.005em;
  --lc-tracking-body-lg: 0;
  --lc-tracking-body: 0;
  --lc-tracking-body-sm: 0;
  --lc-tracking-caption: 0.005em;
  --lc-tracking-overline: 0.08em;
  --lc-tracking-data: 0;
  --lc-tracking-data-sm: 0;
  --lc-duration-instant: 0ms;
  --lc-duration-fast: 120ms;
  --lc-duration-base: 180ms;
  --lc-duration-slow: 240ms;
  --lc-duration-deliberate: 320ms;
  --lc-easing-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --lc-easing-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --lc-easing-emphasis: cubic-bezier(0.34, 1.4, 0.64, 1);
  --lc-z-base: 0;
  --lc-z-raised: 10;
  --lc-z-sticky: 100;
  --lc-z-dropdown: 300;
  --lc-z-overlay: 500;
  --lc-z-modal: 1000;
  --lc-z-toast: 1500;
  --lc-z-tooltip: 2000;
  --lc-tap-target-min: 44px;
  --lc-breakpoint-xs: 390px;
  --lc-breakpoint-sm: 480px;
  --lc-breakpoint-md: 768px;
  --lc-breakpoint-lg: 1024px;
  --lc-breakpoint-xl: 1280px;
  --lc-breakpoint-2xl: 1536px;

  /* semantic — Broadcast light */
  --lc-bg-page: #FAF8F7;
  --lc-surface: #FFFFFF;
  --lc-surface-raised: #FFFFFF;
  --lc-surface-sunken: #F2EFED;
  --lc-surface-inverse: #191512;
  --lc-border: #E6E1DD;
  --lc-border-strong: #CFC7C1;
  --lc-text-primary: #0C1533;
  --lc-text-heading: #1A2E77;
  --lc-text-secondary: #1A2E77;
  --lc-text-muted: #5B6486;
  --lc-text-inverse: #FFFFFF;
  --lc-text-brand: #C93C08;
  --lc-action-primary: #C93C08;
  --lc-action-primary-hover: #A3320A;
  --lc-action-primary-text: #FFFFFF;
  --lc-action-primary-scrim: #5C2010;
  --lc-action-secondary: #F2EFED;
  --lc-action-secondary-text: #3E3733;
  --lc-accent: #0A7A85;
  --lc-accent-bold: #0A7A85;
  --lc-accent-bold-text: #FFFFFF;
  --lc-accent-bold-edge: #0B626C;
  --lc-focus-ring: #0C1533;
  --lc-focus-ring-contrast: #FFFFFF;
  --lc-elevation-sm: 2px 2px 0 rgba(25,21,18,0.10);
  --lc-elevation-md: 4px 4px 0 rgba(25,21,18,0.12);
  --lc-elevation-lg: 8px 8px 0 rgba(25,21,18,0.14);
  --lc-status-draft-bg: #F2EFED;
  --lc-status-draft-fg: #3E3733;
  --lc-status-draft-dot: #756B65;
  --lc-status-published-bg: #E1F6E9;
  --lc-status-published-fg: #0E6B3D;
  --lc-status-published-dot: #12864C;
  --lc-status-underOffer-bg: #FFEEDC;
  --lc-status-underOffer-fg: #8A4600;
  --lc-status-underOffer-dot: #D97706;
  --lc-status-closed-bg: #ECE6FD;
  --lc-status-closed-fg: #4B2A9E;
  --lc-status-closed-dot: #6D45C9;
  --lc-status-archived-bg: #FAF8F7;
  --lc-status-archived-fg: #635A54;
  --lc-status-archived-dot: #948A82;
  --lc-status-unpublished-bg: #FFEAE4;
  --lc-status-unpublished-fg: #A32D12;
  --lc-status-unpublished-dot: #D9411F;
  --lc-channel-instagram: #D62B62;
  --lc-channel-instagram-on: #FFFFFF;
  --lc-channel-whatsapp: #0E7A40;
  --lc-channel-whatsapp-on: #FFFFFF;
  --lc-channel-messenger: #0069CC;
  --lc-channel-messenger-on: #FFFFFF;
  --lc-channel-facebook: #1257A8;
  --lc-channel-facebook-on: #FFFFFF;
  --lc-channel-tiktok: #1B1B1B;
  --lc-channel-tiktok-on: #FFFFFF;
  --lc-channel-x: #111111;
  --lc-channel-x-on: #FFFFFF;
  --lc-channel-linkedin: #0A66C2;
  --lc-channel-linkedin-on: #FFFFFF;
  --lc-channel-olx: #00666F;
  --lc-channel-olx-on: #FFFFFF;
  --lc-channel-bayut: #6B9B2D;
  --lc-channel-bayut-on: #FFFFFF;
  --lc-channel-property_finder: #E31C23;
  --lc-channel-property_finder-on: #FFFFFF;
  --lc-channel-dubizzle: #E4002B;
  --lc-channel-dubizzle-on: #FFFFFF;
  --lc-channel-aqar: #0B7A4B;
  --lc-channel-aqar-on: #FFFFFF;
}

