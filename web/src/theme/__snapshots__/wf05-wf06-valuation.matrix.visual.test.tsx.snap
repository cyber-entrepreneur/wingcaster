exports[`PVA-009 queue light rtl mobile > snapshot 1`] = `
"<!-- mode=light dir=rtl lang=ar viewport=375px -->
<html data-lc-mode="light" style="color-scheme: light;" dir="rtl" lang="ar" data-viewport="mobile"><head><style id="broadcast-theme-css">/* ListingClarion — Broadcast (adopted theme)
   Generated from broadcast-tokens.json. Do not hand-edit: change tokens.js and regenerate.
   Components read only these semantic variables, never a raw hex.
   Light is the default; dark applies via [data-lc-mode="dark"] or prefers-color-scheme.

   Display tokens carry weight 800 — the shorthand already includes it, so
   \`font: var(--lc-type-display)\` renders at the theme's display weight with no extra rule. */

:root {
  --lc-radius-sm: 3px;
  --lc-radius-md: 5px;
  --lc-radius-lg: 7px;
  --lc-radius-xl: 10px;
  --lc-radius-pill: 999px;
  --lc-space-3xs: 2px;
  --lc-space-2xs: 4px;
  --lc-space-xs: 8px;
  --lc-space-sm: 12px;
  --lc-space-md: 16px;
  --lc-space-lg: 20px;
  --lc-space-xl: 24px;
  --lc-space-2xl: 32px;
  --lc-space-3xl: 40px;
  --lc-space-4xl: 48px;
  --lc-space-5xl: 64px;
  --lc-font-display: Archivo, system-ui, sans-serif;
  --lc-font-ui: "IBM Plex Sans", "IBM Plex Sans Arabic", Tahoma, "Segoe UI", system-ui, sans-serif;
  --lc-font-mono: "IBM Plex Mono", ui-monospace, monospace;
  --lc-display-weight: 800;
  --lc-display-tracking: -0.03em;
  --lc-type-display-xl: 800 40px/44px var(--lc-font-display);
  --lc-type-display: 800 32px/38px var(--lc-font-display);
  --lc-type-heading-1: 600 26px/32px var(--lc-font-ui);
  --lc-type-heading-2: 600 21px/28px var(--lc-font-ui);
  --lc-type-heading-3: 600 18px/24px var(--lc-font-ui);
  --lc-type-body-lg: 400 16px/24px var(--lc-font-ui);
  --lc-type-body: 400 15px/22px var(--lc-font-ui);
  --lc-type-body-sm: 400 13px/18px var(--lc-font-ui);
  --lc-type-caption: 500 12px/16px var(--lc-font-ui);
  --lc-type-overline: 600 11px/14px var(--lc-font-ui);
  --lc-type-data: 500 15px/20px var(--lc-font-mono);
  --lc-type-data-sm: 500 13px/18px var(--lc-font-mono);
  --lc-tracking-display-xl: -0.03em;
  --lc-tracking-display: -0.03em;
  --lc-tracking-heading-1: -0.015em;
  --lc-tracking-heading-2: -0.01em;
  --lc-tracking-heading-3: -0.005em;
  --lc-tracking-body-lg: 0;
  --lc-tracking-body: 0;
  --lc-tracking-body-sm: 0;
  --lc-tracking-caption: 0.005em;
  --lc-tracking-overline: 0.08em;
  --lc-tracking-data: 0;
  --lc-tracking-data-sm: 0;
  --lc-duration-instant: 0ms;
  --lc-duration-fast: 120ms;
  --lc-duration-base: 180ms;
  --lc-duration-slow: 240ms;
  --lc-duration-deliberate: 320ms;
  --lc-easing-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --lc-easing-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --lc-easing-emphasis: cubic-bezier(0.34, 1.4, 0.64, 1);
  --lc-z-base: 0;
  --lc-z-raised: 10;
  --lc-z-sticky: 100;
  --lc-z-dropdown: 300;
  --lc-z-overlay: 500;
  --lc-z-modal: 1000;
  --lc-z-toast: 1500;
  --lc-z-tooltip: 2000;
  --lc-tap-target-min: 44px;
  --lc-breakpoint-xs: 390px;
  --lc-breakpoint-sm: 480px;
  --lc-breakpoint-md: 768px;
  --lc-breakpoint-lg: 1024px;
  --lc-breakpoint-xl: 1280px;
  --lc-breakpoint-2xl: 1536px;

  /* semantic — Broadcast light */
  --lc-bg-page: #FAF8F7;
  --lc-surface: #FFFFFF;
  --lc-surface-raised: #FFFFFF;
  --lc-surface-sunken: #F2EFED;
  --lc-surface-inverse: #191512;
  --lc-border: #E6E1DD;
  --lc-border-strong: #CFC7C1;
  --lc-text-primary: #0C1533;
  --lc-text-heading: #1A2E77;
  --lc-text-secondary: #1A2E77;
  --lc-text-muted: #5B6486;
  --lc-text-inverse: #FFFFFF;
  --lc-text-brand: #C93C08;
  --lc-action-primary: #C93C08;
  --lc-action-primary-hover: #A3320A;
