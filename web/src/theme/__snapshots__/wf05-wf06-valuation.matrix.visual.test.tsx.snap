-auto w-full flex-wrap justify-start gap-1 bg-transparent p-0"><button type="button" role="tab" id="pa-queue-status-pending_review" aria-selected="true" tabindex="0" class="inline-flex min-h-tap items-center justify-center gap-1.5 whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium transition-all duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 bg-[var(--lc-surface)] text-[var(--lc-text-primary)] shadow-sm">Pending review<span data-lc-numeric="true" class="lc-data text-[var(--lc-text-muted)]">1</span></button><button type="button" role="tab" id="pa-queue-status-verified" aria-selected="false" tabindex="-1" class="inline-flex min-h-tap items-center justify-center gap-1.5 whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium transition-all duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 text-[var(--lc-text-muted)]">Verified</button><button type="button" role="tab" id="pa-queue-status-incorporated" aria-selected="false" tabindex="-1" class="inline-flex min-h-tap items-center justify-center gap-1.5 whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium transition-all duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 text-[var(--lc-text-muted)]">Incorporated<span data-lc-numeric="true" class="lc-data text-[var(--lc-text-muted)]">12</span></button><button type="button" role="tab" id="pa-queue-status-rejected" aria-selected="false" tabindex="-1" class="inline-flex min-h-tap items-center justify-center gap-1.5 whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium transition-all duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 text-[var(--lc-text-muted)]">Rejected<span data-lc-numeric="true" class="lc-data text-[var(--lc-text-muted)]">4</span></button><button type="button" role="tab" id="pa-queue-status-request_info" aria-selected="false" tabindex="-