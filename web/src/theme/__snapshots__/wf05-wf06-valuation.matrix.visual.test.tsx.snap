secondary)] h-tap w-tap min-h-tap min-w-tap h-tap w-tap shrink-0 text-[var(--lc-text-muted)] hover:text-[var(--lc-text-brand)]" type="button" aria-pressed="false" aria-label="Reveal PII (audited)" title="Reveal PII (audited)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button><span id=":r5a:" class="sr-only" aria-live="polite"></span></span> · Dubai Marina · 2-3BR apartments</span><h1 class="sr-only">Agent price report · Dubai Marina · 2-3BR apartments</h1></div><div class="flex items-center gap-3"><div class="inline-flex items-center rounded-pill border px-2.5 py-0.5 text-xs font-semibold transition-colors focus-visible:outline-none border-transparent bg-[var(--lc-status-warning-bg)] text-[var(--lc-status-warning-fg)]"><span aria-hidden="true" class="me-1">▲</span>Pending second approval</div><span class="text-xs text-[var(--lc-text-muted)]"><span data-lc-numeric="true" class="lc-data">5d ago</span></span><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] h-tap w-tap min-h-tap min-w-tap" type="button" aria-label="Keyboard shortcuts"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-help h-4 w-4"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12