/* Base — the only global rules the theme owns. */
html { color-scheme: light dark; }
body {
  margin: 0;
  background: var(--lc-bg-page);
  color: var(--lc-text-primary);
  font: var(--lc-type-body);
  -webkit-font-smoothing: antialiased;
  transition: background var(--lc-duration-base) var(--lc-easing-in-out), color var(--lc-duration-base) var(--lc-easing-in-out);
}
a { color: var(--lc-text-brand); text-decoration: none; }
a:hover { color: var(--lc-action-primary-hover); text-decoration: underline; }
/* Two-tone focus ring. No single colour clears 3:1 against BOTH the page and the orange
   primary button, so the ring pairs an inner and an outer band — one of them always contrasts,
   whatever the element sits on. Do not collapse this to a single outline. */
:where(button, a, [role="button"], input, select, textarea):focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
}
@supports not (selector(:focus-visible)) {
  :where(button, a, [role="button"], input, select, textarea):focus {
    box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
  }
}
:where(button, a[role="button"], [role="button"]) { min-height: var(--lc-tap-target-min); }
/* Numerals are tabular everywhere — prices and counts must not jitter between rows. */
:where(.lc-data, [data-lc-numeric]) { font-family: var(--lc-font-mono); font-variant-numeric: tabular-nums; }
</style></head><body><div><div class="min-h-screen bg-[var(--lc-bg-page)] text-[var(--lc-text-primary)]"><div role="status" class="border-b border-[var(--lc-border)] bg-[var(--lc-status-warning-bg)] px-4 py-2 text-center text-sm text-[var(--lc-status-warning-fg)] lg:hidden">PA console requires a desktop screen (1024px or wider).</div><div class="mx-auto max-w-[1440px]"><header role="banner" class="sticky top-0 z-10 flex h-16 items-center justify-between gap-4 border-b border-[var(--lc-border)] bg-[var(--lc-surface-raised)] px-[var(--lc-space-2xl)]"><div class="flex min-w-0 items-center gap-3"><a class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" href="/admin/valuation/price-reports"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left me-1 h-4 w-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>Price reports queue</a><span class="truncate text-sm text-[var(--lc-text-secondary)]"><span class="inline-flex max-w-full items-center gap-1.5" data-pii-kind="name" data-pii-revealed="false"><span dir="ltr" class="truncate font-[var(--lc-font-mono)] tabular-nums text-[var(--lc-text-muted)] tracking-[0.05em]" aria-label="Masked name — press V or click reveal to disclose (audited)">S***** A*** M***</span><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap hover:bg-[var(--lc-action-secondary)] h-tap w-tap min-h-tap min-w-tap h-tap w-tap shrink-0 text-[var(--lc-text-muted)] hover:text-[var(--lc-text-brand)]" type="button" aria-pressed="false" aria-label="Reveal PII (audited)" title="Reveal PII (audited)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg></button><span id=":r5s:" class="sr-only" aria-live="polite"></span></span> · Dubai Marina · 2-3BR apartments</span><h1 class="sr-only">Agent price report · Dubai Marina · 2-3BR apartments</h1></div><div class="flex items-center gap-3"><div class="inline-flex items-center rounded-pill border px-2.5 py-0.5 text-xs font-semibold transition-colors focus-visible:outline-none border-transparent bg-[var(--lc-status-warning-bg)] text-[var(--lc-status-warning-fg)]"><span aria-hidden="true" class="me-1">▲</span>Pending second approval</div><span class="text-xs text-[var(--lc-text-muted)]"><span data-lc-numeric="true" class="lc-data">5d ago</span></span><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] h-tap w-tap min-h-tap min-w-tap" type="button" aria-label="Keyboard shortcuts"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-help h-4 w-4"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12