tton type="button" class="flex min-h-tap w-full items-center justify-between gap-[var(--lc-space-md)] px-[var(--lc-space-md)] py-[var(--lc-space-sm)] text-start" aria-expanded="false" aria-controls=":r19:"><span class="text-[var(--lc-text-heading)]" style="font: var(--lc-type-body);">What you originally submitted</span><span class="flex items-center gap-[var(--lc-space-sm)]"><span data-lc-numeric="true" class="lc-data text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);" dir="ltr">apr_1</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-[var(--lc-text-muted)] transition-transform duration-base ease-out motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id=":r19:" hidden="" class="border-t border-[var(--lc-border)] px-[var(--lc-space-md)] py-[var(--lc-space-md)]"><div class="mb-[var(--lc-space-sm)]" style="font: var(--lc-type-body-sm);"><span class="text-[var(--lc-text-muted)]">Market segment: </span><div class="inline-flex items-center rounded-pill border px-2.5 py-0.5 text-xs font-semibold transition-colors focus-visible:outline-none text-[var(--lc-text-primary)] border-[var(--lc-border)] rounded-pill">Dubai Marina · 2-3BR apartments</div></div></div></div></div><p class="py-[var(--lc-space-lg)] text-center"><a class="text-[var(--lc-text-brand)] underline-offset-2 hover:underline" style="font: var(--lc-type-body-sm);" href="/notifications?support=1&amp;context=Price%20report%20ID%3A%20apr_1">Something not right? Contact WingCaster support</a></p></div><aside class="hidden lg:block"><div class="sticky top-[var(--lc-space-3xl)] space-y-[var(--lc-space-md)]"><div class="flex w-full max-w-[320px] flex-col gap-[var(--lc-space-sm)]" data-rec-cta-layout="stacked"><a href="/public/agent/me" class="inline-flex items-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap px-4 py-2 min-h-tap w-full justify-center">View on your public profile</a><a href="/agent/pricing?highlight_signal_id=apr_1" class="inline-flex items-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 min-h-tap w-full justify-center">View live signal</a></div><div class="rounded-lg bg-[var(--lc-surface-sunken)] p-[var(--lc-space-md)] text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);"><p>Report ID: <span data-lc-numeric="true" class="lc-data" dir="ltr">apr_1</span></p><p class="mt-1">Submitted: <span data-lc-numeric="true" class="lc-data" dir="ltr">2026-09-01T10:00:00Z</span></p><p class="mt-1">Decided: <span data-lc-numeric="true" class="lc-data" dir="ltr">2026-09-04T09:00:00Z</span></p><p class="mt-1">Effective: <span data-lc-numeric="true" class="lc-data" dir="ltr">2026-09-05T00:00:00Z</span></p></div></div></aside></div><div class="fixed inset-x-0 bottom-0 z-20 border-t border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-md)] pb-[max(var(--lc-space-md),env(safe-area-inset-bottom))] shadow-md lg:hidden"><div class="flex w-full max-w-[320px] flex-col gap-[var(--lc-space-sm)]" data-rec-cta-layout="stacked"><a href="/public/agent/me" class="inline-flex items-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap px-4 py-2 min-h-tap w-full justify-center">View on your public profile</a><a href="/agent/pricing?highlight_signal_id=apr_1" class="inline-flex items-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 min-h-tap w-full justify-center">View live signal</a></div></div></div><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-toast flex max-w-[420px] flex-col gap-2 p-4 sm:bottom-0 sm:end-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div></div></body></html>"
