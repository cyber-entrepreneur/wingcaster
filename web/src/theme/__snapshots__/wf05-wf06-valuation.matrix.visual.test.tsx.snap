tion data-testid="weighting-panel" data-weight-mode="incorporated" data-weight="100" aria-label="Signal weighting" class="rounded-lg bg-[var(--lc-surface-sunken)] p-[var(--lc-space-lg)]" dir="ltr"><p class="text-[var(--lc-text-primary)]" style="font: var(--lc-type-body);">Applied weight: <strong data-lc-numeric="true" class="lc-data font-semibold" aria-label="100 percent">100%</strong></p><div class="relative mt-[var(--lc-space-md)] h-3 w-full"><div class="absolute inset-0 rounded-[var(--lc-radius-sm)] bg-[var(--lc-border)]" aria-hidden="true"></div><div role="meter" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-label="Signal weight applied by Platform Administrator" class="absolute inset-y-0 start-0 rounded-[var(--lc-radius-sm)] bg-[var(--lc-accent-bold)] outline outline-1 outline-[var(--lc-accent-bold-edge)]" style="width: 100%;"></div><span aria-hidden="true" class="absolute top-0 bottom-0 w-px bg-[var(--lc-border-strong)]" style="left: 25%;"></span><span aria-hidden="true" class="absolute top-0 bottom-0 w-px bg-[var(--lc-border-strong)]" style="left: 50%;"></span><span aria-hidden="true" class="absolute top-0 bottom-0 w-px bg-[var(--lc-border-strong)]" style="left: 75%;"></span><span aria-hidden="true" class="absolute top-0 bottom-0 w-px bg-[var(--lc-border-strong)]" style="left: 100%;"></span></div><p class="mt-[var(--lc-space-md)] text-[var(--lc-text-primary)]" style="font: var(--lc-type-body-sm);">Your signal is being used as <strong>authoritative</strong> in Dubai Marina · 2-3BR apartments.</p><p class="mt-[var(--lc-space-xs)] text-[var(--lc-text-muted)]" style="font: var(--lc-type-body-sm);">Signal is live on the platform pricing model from <span data-lc-numeric="true" class="lc-data" aria-label="Effective on Sep 05, 2026">Sep 05, 2026</span>.</p></section><div id="price-original-report"><div class="rounded-lg border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] shadow-sm"><h2 class="sr-only">What you originally submitted</h2><button type="button" class="flex min-h-tap w-full items-center justify-between gap-[var(--lc-space-md)] px-[var(--lc-space-md)] py-[var(--lc-space-sm)] text-start" aria-expanded="false" aria-controls=":rh:"><span class="text-[var(--lc-text-heading)]" style="font: var(--lc-type-body);">What you originally submitted</span><span class="flex items-center gap-[var(--lc-space-sm)]"><span data-lc-numeric="true" class="lc-data text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);" dir="ltr">apr_1</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 text-[var(--lc-text-muted)] transition-transform duration-base ease-out motion-reduce:transition-none" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button><div id=":rh:" hidden="" class="border-t border-[var(--lc-border)] px-[var(--lc-space-md)] py-[var(--lc-space-md)]"><div class="mb-[var(--lc-space-sm)]" style="font: var(--lc-type-body-sm);"><span class="text-[var(--lc-text-muted)]">Market segment: </span><div class="inline-flex items-center rounded-pill border px-2.5 py-0.5 text-xs font-semibold transition-colors focus-visible:outline-none text-[var(--lc-text-primary)] border-[var(--lc-border)] rounded-pill">Dubai Marina · 2-3BR apartments</div></div></div></div></div><p class="py-[var(--lc-space-lg)] text-center"><a class="text-[var(--lc-text-brand)] underline-offset-2 hover:underline" style="font: var(--lc-type-body-sm);" href="/notifications?support=1&amp;context=Price%20report%20ID%3A%20apr_1">Something not right? Contact WingCaster support</a></p></div><aside class="hidden lg:block"><div class="sticky top-[var(--lc-space-3xl)] space-y-[var(--lc-space-md)]"><div class="flex w-full max-w-[320px] flex-col gap-[var(--lc-space-sm)]" data-rec-cta-layout="stacked"><a href="/public/agent/me" class="inline-flex items-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap px-4 py-2 min-h-tap w-full justify-center">View on your public profile</a><a href="/agent/pricing?highlight_signal_id=apr_1" class="inline-flex items-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 min-h-tap w-full justify-center">View live signal</a></div><div class="rounded-lg bg-[var(--lc-surface-sunken)] p-[var(--lc-space-md)] text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);"><p>Report ID: <span data-lc-numeric="true" class="lc-data" dir="ltr">apr_1</span></p><p class="mt-1">Submitted: <span data-lc-numeric="true" class="lc-data" dir="ltr">2026-09-01T10:00:00Z</span></p><p class="mt-1">Decided: <span data-lc-numeric="true" class="lc-data" dir="ltr">2026-09-04T09:00:00Z</span></p><p class="mt-1">Effective: <span data-lc-numeric="true" class="lc-data" dir="ltr">2026-09-05T00:00:00Z</span></p></div></div></aside></div><div class="fixed inset-x-0 bottom-0 z-20 border-t border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-md)] pb-[max(var(--lc-space-md),env(safe-area-inset-bottom))] shadow-md lg:hidden"><div class="flex w-full max-w-[320px] flex-col gap-[var(--lc-space-sm)]" data-rec-cta-layout="stacked"><a href="/public/agent/me" class="inline-flex items-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap px-4 py-2 min-h-tap w-full justify-center">View on your public profile</a><a href="/agent/pricing?highlight_signal_id=apr_1" class="inline-flex items-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 min-h-tap w-full justify-center">View live signal</a></div></div></div><div role="region" aria-label="Notifications (F8)" tabindex="-1" style="pointer-events: none;"><ol tabindex="-1" class="fixed top-0 z-toast flex max-w-[420px] flex-col gap-2 p-4 sm:bottom-0 sm:end-0 sm:top-auto sm:flex-col md:max-w-[420px]"></ol></div></div></body></html>"
`;

exports[`REC-003 incorporated light ltr mobile > snapshot 1`] = `
"<!-- mode=light dir=ltr lang=en viewport=375px -->
<html data-lc-mode="light" style="color-scheme: light;" dir="ltr" lang="en" data-viewport="mobile"><head><style id="broadcast-theme-css">/* ListingClarion — Broadcast (adopted theme)
   Generated from broadcast-tokens.json. Do not hand-edit: change tokens.js and regenerate.
   Components read only these semantic variables, never a raw hex.
   Light is the default; dark applies via [data-lc-mode="dark"] or prefers-color-scheme.

   Display tokens carry weight 800 — the shorthand already includes it, so
   \`font: var(--lc-type-display)\` renders at the theme's display weight with no extra rule. */

:root {
  --lc-radius-sm: 3px;
  --lc-radius-md: 5px;
  --lc-radius-lg: 7px;
  --lc-radius-xl: 10px;
  --lc-radius-pill: 999px;
  --lc-space-3xs: 2px;
  --lc-space-2xs: 4px;
  --lc-space-xs: 8px;
  --lc-space-sm: 12px;
  --lc-space-md: 16px;
  --lc-space-lg: 20px;
  --lc-space-xl: 24px;
  --lc-space-2xl: 32px;
