t-start [font:var(--lc-type-heading-2)] [letter-spacing:var(--lc-tracking-heading-2)] md:[font:var(--lc-type-heading-1)] md:[letter-spacing:var(--lc-tracking-heading-1)]">Your price signal is now live</h1><span data-lc-numeric="true" class="lc-data mt-[var(--lc-space-xs)] block text-[var(--lc-action-primary-text)] opacity-90" style="font: var(--lc-type-caption);" aria-label="Status timestamp 11 days ago · 05 Sept 2026, 00:00">11 days ago · 05 Sept 2026, 00:00</span></div></div></section><div class="mx-auto grid max-w-[1200px] gap-[var(--lc-space-lg)] px-[var(--lc-space-md)] py-[var(--lc-space-md)] lg:grid-cols-[65%_35%]"><div class="min-w-0 space-y-[var(--lc-space-lg)]"><div class="rounded-lg border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-md)] shadow-sm"><div class="flex items-start gap-[var(--lc-space-md)]"><div class="min-w-0 flex-1 text-start"><h2 class="text-[var(--lc-text-heading)]" style="font: var(--lc-type-heading-3);">2-3BR apartments · Dubai Marina · Sep 2026</h2><p class="mt-1 text-[var(--lc-text-muted)]" style="font: var(--lc-type-body-sm);">Dubai Marina · 2-3BR apartments</p><span data-lc-numeric="true" class="lc-data mt-[var(--lc-space-xs)] block text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);" dir="ltr">Sep 01, 2026, 10:00 AM</span></div><button type="button" aria-label="View this price report" class="inline-flex min-h-tap min-w-tap items-center justify-center text-[var(--lc-text-muted)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div><style>
        @keyframes lc-rec-signal-pulse {
          0%, 100% { opacity: 1; transform: scale(1); }
          50% { opacity: 0.55; transform: scale(1.15); }
        }
        .lc-rec-signal-dot {
          animation: lc-rec-signal-pulse var(--lc-duration-slow) var(--lc-easing-emphasis) infinite;
        }
        @media (prefers-reduced-motion: reduce) {
          .lc-rec-signal-dot { animation: none; }
        }
