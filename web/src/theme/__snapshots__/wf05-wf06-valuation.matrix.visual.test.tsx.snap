ceholder="cmp_… or listing id" required="" value="cmp_1"></div><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="bcr-comparable-type">Comparable type</label><select id="bcr-comparable-type" class="min-h-tap w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] px-3 text-sm text-[var(--lc-text-primary)]"><option value="internal">internal</option><option value="external">external</option><option value="agent_report">agent_report</option></select></div><fieldset class="space-y-[var(--lc-space-sm)]"><legend class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">Why are you reporting this?</legend><div role="radiogroup" aria-label="Why are you reporting this?" class="grid grid-cols-2 gap-[var(--lc-space-sm)] md:grid-cols-3"><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-incorrect_price" class="relative flex min-h-[88px] flex-col items-start gap-1 rounded-[var(--lc-radius-md)] p-[var(--lc-space-sm)] text-start transition-[border-color,background-color] duration-fast border border-[var(--lc-border)] bg-[var(--lc-surface-raised)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dollar-sign h-5 w-5 text-[var(--lc-text-muted)]" aria-hidden="true"><line x1="12" x2="12" y1="2" y2="22"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg><span class="text-sm font-medium text-[var(--lc-text-primary)]">Wrong price</span><span id="bcr-reason-help-incorrect_price" class="text-xs text-[var(--lc-text-muted)]">The listed price doesn't match reality.</span></button><button type="button" role="radio" aria-checked="false" aria-describedby="bcr-reason-help-wrong_detail