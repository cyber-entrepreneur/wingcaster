/* Base — the only global rules the theme owns. */
html { color-scheme: light dark; }
body {
  margin: 0;
  background: var(--lc-bg-page);
  color: var(--lc-text-primary);
  font: var(--lc-type-body);
  -webkit-font-smoothing: antialiased;
  transition: background var(--lc-duration-base) var(--lc-easing-in-out), color var(--lc-duration-base) var(--lc-easing-in-out);
}
a { color: var(--lc-text-brand); text-decoration: none; }
a:hover { color: var(--lc-action-primary-hover); text-decoration: underline; }
/* Two-tone focus ring. No single colour clears 3:1 against BOTH the page and the orange
   primary button, so the ring pairs an inner and an outer band — one of them always contrasts,
   whatever the element sits on. Do not collapse this to a single outline. */
:where(button, a, [role="button"], input, select, textarea):focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
}
@supports not (selector(:focus-visible)) {
  :where(button, a, [role="button"], input, select, textarea):focus {
    box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
  }
}
:where(button, a[role="button"], [role="button"]) { min-height: var(--lc-tap-target-min); }
/* Numerals are tabular everywhere — prices and counts must not jitter between rows. */
:where(.lc-data, [data-lc-numeric]) { font-family: var(--lc-font-mono); font-variant-numeric: tabular-nums; }
</style></head><body><div><div class="min-h-screen bg-[var(--lc-bg-page)] px-4 py-[var(--lc-space-2xl)] pb-[var(--lc-space-4xl)] sm:px-6" data-testid="price-report-page" dir="ltr"><div class="mx-auto max-w-[760px] space-y-[var(--lc-space-lg)]"><header class="flex flex-col gap-[var(--lc-space-md)] rounded-[var(--lc-radius-lg)] bg-[var(--lc-surface-sunken)] p-[var(--lc-space-xl)] sm:flex-row sm:items-start sm:justify-between"><div class="flex items-start gap-[var(--lc-space-sm)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles mt-1 h-6 w-6 shrink-0 text-[var(--lc-accent-bold-edge)]" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg><div><h1 class="text-[length:var(--lc-type-heading-1)] text-[var(--lc-text-heading)]">Submit a price report</h1><p class="mt-1 text-[length:var(--lc-type-body)] text-[var(--lc-text-muted)]">Your expert take on market pricing, reviewed by PA and published to your public profile.</p></div></div><div class="rounded-pill px-2.5 py-0.5 text-xs font-semibold transition-colors focus-visible:outline-none inline-flex items-center gap-1 border border-[var(--lc-accent-bold-edge)] bg-[var(--lc-accent-bold)] text-[var(--lc-accent-bold-text)]" aria-label="Pro-tier feature"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crown h-3.5 w-3.5" aria-hidden="true"><path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg>Pro feature</div></header><ol class="flex flex-wrap items-center gap-[var(--lc-space-sm)] text-[length:var(--lc-type-caption)] text-[var(--lc-text-muted)]" aria-label="Report sections"><li class="inline-flex items-center gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-accent-bold-edge)] text-[var(--lc-accent-bold-edge)]" aria-current="step">1</span><span>Subject</span></li><li class="inline-flex items-center gap-2"><span class="hidden h-px w-6 bg-[var(--lc-border-strong)] sm:inline-block" aria-hidden="true"></span><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-border-strong)]">2</span><span>Recommendation</span></li><li class="inline-flex items-center gap-2"><span class="hidden h-px w-6 bg-[var(--lc-border-strong)] sm:inline-block" aria-hidden="true"></span><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-border-strong)]">3</span><span>Rationale</span></li><li class="inline-flex items-center gap-2"><span class="hidden h-px w-6 bg-[var(--lc-border-strong)] sm:inline-block" aria-hidden="true"></span><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-border-strong)]">4</span><span>Publication</span></li></ol><form class="space-y-[var(--lc-space-lg)]" novalidate=""><section aria-labelledby="apr-section-1" class="rounded-[var(--lc-radius-lg)] border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-xl)] shadow-[var(--lc-elevation-sm)]"><h2 id="apr-section-1" class="text-[length:var(--lc-type-heading-2)] text-[var(--lc-text-heading)]">1. Subject</h2><p class="mt-[var(--lc-space-2xs)] text-[length:var(--lc-type-body-sm)] text-[var(--lc-text-muted)]">What is this report about?</p><div class="mt-[var(--lc-space-lg)] space-y-[var(--lc-space-md)]"><div role="radiogroup" aria-label="What is this report about?" class="flex max-w-md overflow-hidden rounded-[var(--lc-radius-pill)] border border-[var(--lc-border)] bg-[var(--lc-surface-sunken)]"><button type="button" role="radio" aria-checked="false" class="min-h-tap flex-1 px-3 text-sm transition-colors duration-fast text-[var(--lc-text-primary)]">Specific property</button><button type="button" role="radio" aria-checked="true" class="min-h-tap flex-1 px-3 text-sm transition-colors duration-fast bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)]">External / off-platform sale</button></div><div class="grid gap-[var(--lc-space-md)] sm:grid-cols-2"><div class="space-y-[var(--lc-space-sm)] sm:col-span-2"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-ext-title">Property title</label><input class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" id="apr-ext-title" value=""></div><div class="space-y-[var(--lc-space-sm)] sm:col-span-2"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-ext-location">Location</label><input class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" id="apr-ext-location" value=""></div></div></div></section><section aria-labelledby="apr-section-2" class="rounded-[var(--lc-radius-lg)] border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-xl)] shadow-[var(--lc-elevation-sm)] opacity-60"><h2 id="apr-section-2" class="text-[length:var(--lc-type-heading-2)] text-[var(--lc-text-heading)]">2. Recommendation</h2><p class="mt-[var(--lc-space-2xs)] text-[length:var(--lc-type-body-sm)] text-[var(--lc-text-muted)]">What sold-price evidence are you reporting?</p><div class="mt-[var(--lc-space-lg)] space-y-[var(--lc-space-md)]"><div class="grid gap-[var(--lc-space-md)] sm:grid-cols-[120px_1fr_160px]"><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-currency">Currency</label><select id="apr-currency" class="min-h-tap w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] px-3 text-sm" disabled=""><option value="AED">AED</option><option value="USD">USD</option><option value="SAR">SAR</option><option value="EGP">EGP</option><option value="LBP">LBP</option><option value="JOD">JOD</option><option value="OMR">OMR</option><option value="BHD">BHD</option><option value="KWD">KWD</option></select></div><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-amount">Sold price</label><input type="number" inputmode="decimal" data-lc-numeric="" class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 font-[family-name:var(--lc-font-mono)] tabular-nums" id="apr-amount" min="1" step="any" disabled="" aria-invalid="false" value=""></div><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-sold-date">Completion date</label><input type="date" class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" id="apr-sold-date" max="2026-09-15" disabled="" value=""></div></div></div></section><section aria-labelledby="apr-section-3" class="rounded-[var(--lc-radius-lg)] border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-xl)] shadow-[var(--lc-elevation-sm)] opacity-60"><h2 id="apr-section-3" class="text-[length:var(--lc-type-heading-2)] text-[var(--lc-text-heading)]">3. Rationale</h2><p class="mt-[var(--lc-space-2xs)] text-[length:var(--lc-type-body-sm)] text-[var(--lc-text-muted)]">What supports your recommendation?</p><div class="mt-[var(--lc-space-lg)] space-y-[var(--lc-space-md)]"><div class="space-y-[var(--lc-space-sm)]"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-notes">Evidence notes</label><textarea id="apr-notes" rows="6" placeholder="Explain your reasoning. What does the data show that the raw price alone misses?" disabled="" class="w-full rounded-[var(--lc-radius-md)] border border-[var(--lc-border-strong)] bg-[var(--lc-surface-raised)] px-3 py-2 text-sm text-[var(--lc-text-primary)] disabled:opacity-60" aria-invalid="false"></textarea><div class="flex items-start justify-between gap-2"><p class="text-xs text-[var(--lc-text-muted)]"></p><p class="text-end text-[length:var(--lc-type-caption)] text-[var(--lc-text-muted)]" aria-hidden="true"><span data-lc-numeric="true" class="lc-data">0</span> / <span data-lc-numeric="true" class="lc-data">3000</span></p></div></div><fieldset class="space-y-[var(--lc-space-sm)]"><legend class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">How confident are you?</legend><div role="radiogroup" aria-label="How confident are you?" class="flex max-w-[360px] overflow-hidden rounded-[var(--lc-radius-pill)] border border-[var(--lc-border)] bg-[var(--lc-surface-sunken)]"><button type="button" role="radio" aria-checked="true" class="min-h-tap flex-1 px-2 text-xs transition-colors duration-fast bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)]">I saw this myself</button><button type="button" role="radio" aria-checked="false" class="min-h-tap flex-1 px-2 text-xs transition-colors duration-fast text-[var(--lc-text-primary)]">Colleague told me</button><button type="button" role="radio" aria-checked="false" class="min-h-tap flex-1 px-2 text-xs transition-colors duration-fast text-[var(--lc-text-primary)]">I have hard evidence</button></div></fieldset></div></section><section aria-labelledby="apr-section-4" class="rounded-[var(--lc-radius-lg)] border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-xl)] shadow-[var(--lc-elevation-sm)] opacity-60"><h2 id="apr-section-4" class="text-[length:var(--lc-type-heading-2)] text-[var(--lc-text-heading)]">4. Publication</h2><p class="mt-[var(--lc-space-2xs)] text-[length:var(--lc-type-body-sm)] text-[var(--lc-text-muted)]">How should PA handle review?</p><div class="mt-[var(--lc-space-lg)] space-y-[var(--lc-space-md)]"><div class="flex flex-col gap-[var(--lc-space-sm)]"><label for=":rc:" class="text-[length:var(--lc-type-overline)] text-[var(--lc-text-muted)]">Evidence (optional, up to 5 files)</label><p class="text-sm text-[var(--lc-text-muted)]">Attach the data behind your analysis — CSVs, developer decks, sold-price screenshots. PA reviews faster with sources they can verify.</p><ul role="list" class="grid gap-[var(--lc-space-sm)] grid-cols-[repeat(auto-fill,minmax(96px,1fr))] md:grid-cols-[repeat(auto-fill,minmax(120px,1fr))]"></ul><input type="file" class="sr-only" accept="image/jpeg,image/png,image/webp,application/pdf" multiple="" disabled="" tabindex="-1" aria-hidden="true"><div class="sr-only" aria-live="polite"></div></div></div></section><div class="sticky bottom-0 z-10 flex flex-col gap-[var(--lc-space-sm)] border-t border-[var(--lc-border)] bg-[var(--lc-surface-raised)] py-[var(--lc-space-md)] shadow-[var(--lc-elevation-sm)] sm:flex-row sm:items-center sm:justify-between"><p class="text-xs text-[var(--lc-text-muted)]">Your draft autosaves every 30 seconds.</p><div class="flex flex-col-reverse gap-[var(--lc-space-sm)] sm:flex-row sm:items-center"><button class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap px-4 py-2 min-h-tap" type="button" disabled="">Save as draft</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)] hover:bg-[var(--lc-action-primary-hover)] min-h-tap rounded-md px-8 min-h-tap" type="submit" disabled="" aria-describedby="apr-submit-hint">Submit for PA review</button><span id="apr-submit-hint" class="sr-only">Submit disabled: Pick a subject before submitting.</span></div></div></form></div></div></div></body></html>"
`;

