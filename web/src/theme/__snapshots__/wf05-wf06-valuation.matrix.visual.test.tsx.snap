      </style><ol class="relative ms-[var(--lc-space-md)] list-none p-0 pe-[var(--lc-space-md)] ps-0"><li class="relative flex min-h-[var(--lc-space-2xl)] gap-[var(--lc-space-md)] pb-[var(--lc-space-md)] last:pb-0" data-rec-timeline-state="complete"><div class="relative flex w-3 shrink-0 flex-col items-center"><span aria-hidden="true" class="relative z-[1] block h-3 w-3 rounded-full bg-[var(--lc-accent-bold)] outline outline-1 outline-[var(--lc-accent-bold-edge)]"></span><span aria-hidden="true" class="absolute inset-x-0 top-3 bottom-0 mx-auto w-0.5" style="background: var(--lc-accent-bold-edge);"></span></div><div class="min-w-0 flex-1 text-start"><p class="text-[var(--lc-text-primary)]" style="font: var(--lc-type-body);">Submitted</p><span data-lc-numeric="true" class="lc-data mt-0.5 block text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);">01 Sept 2026, 10:00</span></div></li><li class="relative flex min-h-[var(--lc-space-2xl)] gap-[var(--lc-space-md)] pb-[var(--lc-space-md)] last:pb-0" data-rec-timeline-state="complete"><div class="relative flex w-3 shrink-0 flex-col items-center"><span aria-hidden="true" class="relative z-[1] block h-3 w-3 rounded-full bg-[var(--lc-accent-bold)] outline outline-1 outline-[var(--lc-accent-bold-edge)]"></span><span aria-hidden="true" class="absolute inset-x-0 top-3 bottom-0 mx-auto w-0.5" style="background: var(--lc-accent-bold-edge);"></span></div><div class="min-w-0 flex-1 text-start"><p class="text-[var(--lc-text-primary)]" style="font: var(--lc-type-body);">In Platform Administrator review</p><span data-lc-numeric="true" class="lc-data mt-0.5 block text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);">04 Sept 2026, 09:00</span></div></li><li class="relative flex min-h-[var(--lc-space-2xl)] gap-[var(--lc-space-md)] pb-[var(--lc-space-md)] last:pb-0" data-rec-timeline-state="complete"><div class="relative flex w-3 shrink-0 flex-col items-center"><span aria-hidden="true" class="relative z-[1] block h-