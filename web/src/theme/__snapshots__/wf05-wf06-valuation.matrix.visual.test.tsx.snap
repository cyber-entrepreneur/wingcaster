.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path></svg>Pro feature</div></header><ol class="flex flex-wrap items-center gap-[var(--lc-space-sm)] text-[length:var(--lc-type-caption)] text-[var(--lc-text-muted)]" aria-label="Report sections"><li class="inline-flex items-center gap-2"><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-accent-bold-edge)] text-[var(--lc-accent-bold-edge)]" aria-current="step">1</span><span>Subject</span></li><li class="inline-flex items-center gap-2"><span class="hidden h-px w-6 bg-[var(--lc-border-strong)] sm:inline-block" aria-hidden="true"></span><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-border-strong)]">2</span><span>Recommendation</span></li><li class="inline-flex items-center gap-2"><span class="hidden h-px w-6 bg-[var(--lc-border-strong)] sm:inline-block" aria-hidden="true"></span><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-border-strong)]">3</span><span>Rationale</span></li><li class="inline-flex items-center gap-2"><span class="hidden h-px w-6 bg-[var(--lc-border-strong)] sm:inline-block" aria-hidden="true"></span><span class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-xs border-[var(--lc-border-strong)]">4</span><span>Publication</span></li></ol><form class="space-y-[var(--lc-space-lg)]" novalidate=""><section aria-labelledby="apr-section-1" class="rounded-[var(--lc-radius-lg)] border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-xl)] shadow-[var(--lc-elevation-sm)]"><h2 id="apr-section-1" class="text-[length:var(--lc-type-heading-2)] text-[var(--lc-text-heading)]">1. Subject</h2><p class="mt-[var(--lc-space-2xs)] text-[length:var(--lc-type-body-sm)] text-[var(--lc-text-muted)]">What is this report about?</p><div class="mt-[var(--lc-space-lg)] space-y-[var(--lc-space-md)]"><div role="radiogroup" aria-label="What is this report about?" class="flex max-w-md overflow-hidden rounded-[var(--lc-radius-pill)] border border-[var(--lc-border)] bg-[var(--lc-surface-sunken)]"><button type="button" role="radio" aria-checked="false" class="min-h-tap flex-1 px-3 text-sm transition-colors duration-fast text-[var(--lc-text-primary)]">Specific property</button><button type="button" role="radio" aria-checked="true" class="min-h-tap flex-1 px-3 text-sm transition-colors duration-fast bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)]">External / off-platform sale</button></div><div class="grid gap-[var(--lc-space-md)] sm:grid-cols-2"><div class="space-y-[var(--lc-space-sm)] sm:col-span-2"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-ext-title">Property title</label><input class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" id="apr-ext-title" value=""></div><div class="space-y-[var(--lc-space-sm)] sm:col-span-2"><label class="text-sm font-medium leading-none text-[var(--lc-text-primary)] peer-disabled:cursor-not-allowed peer-disabled:opacity-70" for="apr-ext-location">Location</label><input class="flex min-h-tap w-full rounded-md border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] px-3 py-2 text-sm text-[var(--lc-text-primary)] file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-[var(--lc-text-muted)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50" id="apr-ext