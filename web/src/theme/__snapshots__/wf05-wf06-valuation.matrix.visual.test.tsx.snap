/* Base — the only global rules the theme owns. */
html { color-scheme: light dark; }
body {
  margin: 0;
  background: var(--lc-bg-page);
  color: var(--lc-text-primary);
  font: var(--lc-type-body);
  -webkit-font-smoothing: antialiased;
  transition: background var(--lc-duration-base) var(--lc-easing-in-out), color var(--lc-duration-base) var(--lc-easing-in-out);
}
a { color: var(--lc-text-brand); text-decoration: none; }
a:hover { color: var(--lc-action-primary-hover); text-decoration: underline; }
/* Two-tone focus ring. No single colour clears 3:1 against BOTH the page and the orange
   primary button, so the ring pairs an inner and an outer band — one of them always contrasts,
   whatever the element sits on. Do not collapse this to a single outline. */
:where(button, a, [role="button"], input, select, textarea):focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
}
@supports not (selector(:focus-visible)) {
  :where(button, a, [role="button"], input, select, textarea):focus {
    box-shadow: 0 0 0 2px var(--lc-focus-ring), 0 0 0 4px var(--lc-focus-ring-contrast);
  }
}
:where(button, a[role="button"], [role="button"]) { min-height: var(--lc-tap-target-min); }
/* Numerals are tabular everywhere — prices and counts must not jitter between rows. */
:where(.lc-data, [data-lc-numeric]) { font-family: var(--lc-font-mono); font-variant-numeric: tabular-nums; }
</style></head><body><div><div class="min-h-screen bg-[var(--lc-bg-page)] pb-28 md:pb-[var(--lc-space-3xl)]"><header class="sticky top-0 z-10 flex h-12 items-center gap-[var(--lc-space-sm)] border-b border-[var(--lc-border)] bg-[var(--lc-surface-raised)] px-[var(--lc-space-md)]"><a aria-label="Back" class="inline-flex min-h-tap min-w-tap items-center justify-center text-[var(--lc-text-heading)]" href="/agent/pricing"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left h-5 w-5 rtl:rotate-180" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></a><h1 class="flex-1 text-center text-[var(--lc-text-heading)]" style="font: var(--lc-type-body);">Price report status</h1><span class="min-w-tap" aria-hidden="true"></span></header><div aria-live="polite" class="sr-only">Price report status: Your price signal is now live</div><section aria-labelledby="status-hero-label" data-rec-status="approved" data-rec-emphasis="loud" class="w-full px-[var(--lc-space-md)] py-[var(--lc-space-xl)] transition-colors duration-[var(--lc-duration-base)] ease-[var(--lc-easing-out)] motion-reduce:transition-none bg-[var(--lc-action-primary)] text-[var(--lc-action-primary-text)]"><div class="mx-auto flex max-w-[1200px] items-start gap-[var(--lc-space-md)]"><span class="inline-flex shrink-0 items-center justify-center rounded-full bg-[var(--lc-action-primary-text)] p-2" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check h-7 w-7 md:h-8 md:w-8 text-[var(--lc-action-primary)]"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></span><div class="min-w-0 flex-1 text-start"><h1 id="status-hero-label" class="text-start [font:var(--lc-type-heading-2)] [letter-spacing:var(--lc-tracking-heading-2)] md:[font:var(--lc-type-heading-1)] md:[letter-spacing:var(--lc-tracking-heading-1)]">Your price signal is now live</h1><span data-lc-numeric="true" class="lc-data mt-[var(--lc-space-xs)] block text-[var(--lc-action-primary-text)] opacity-90" style="font: var(--lc-type-caption);" aria-label="Status timestamp 11 days ago · 05 Sept 2026, 00:00">11 days ago · 05 Sept 2026, 00:00</span></div></div></section><div class="mx-auto grid max-w-[1200px] gap-[var(--lc-space-lg)] px-[var(--lc-space-md)] py-[var(--lc-space-md)] lg:grid-cols-[65%_35%]"><div class="min-w-0 space-y-[var(--lc-space-lg)]"><div class="rounded-lg border border-[var(--lc-border)] bg-[var(--lc-surface-raised)] p-[var(--lc-space-md)] shadow-sm"><div class="flex items-start gap-[var(--lc-space-md)]"><div class="min-w-0 flex-1 text-start"><h2 class="text-[var(--lc-text-heading)]" style="font: var(--lc-type-heading-3);">2-3BR apartments · Dubai Marina · Sep 2026</h2><p class="mt-1 text-[var(--lc-text-muted)]" style="font: var(--lc-type-body-sm);">Dubai Marina · 2-3BR apartments</p><span data-lc-numeric="true" class="lc-data mt-[var(--lc-space-xs)] block text-[var(--lc-text-muted)]" style="font: var(--lc-type-caption);" dir="ltr">Sep 01, 2026, 10:00 AM</span></div><button type="button" aria-label="View this price report" class="inline-flex min-h-tap min-w-tap items-center justify-center text-[var(--lc-text-muted)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 rtl:rotate-180" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div><style>
