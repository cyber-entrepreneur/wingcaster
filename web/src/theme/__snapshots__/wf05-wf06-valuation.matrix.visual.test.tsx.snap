acity-0 md:group-hover:opacity-100"><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border bg-[var(--lc-surface)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3 border-[var(--lc-action-primary)] text-[var(--lc-action-primary)]" type="button">Incorporate</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" type="button">Signal only</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" type="button">Reject</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border bg-[var(--lc-surface)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3 border-[var(--lc-status-warning-fg)] text-[var(--lc-status-warning-fg)]" type="button">Request info</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" type="button">Open</button></div></td></tr></tbody></table></div></div></div><footer class="mt-[var(--lc-space-md)] flex items-center justify-between text-sm text-[var(--lc-text-muted)]"><span><span data-lc-numeric="true" class="lc-data">1</span>–<span data-lc-numeric="true" class="lc-data">1</span> of <span data-lc-numeric="true" class="lc-data">1</span></span><div class="flex gap-2"><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" type="button" disabled="">Previous</button><button class="inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-[background-color,color,box-shadow] duration-fast ease-out focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50 min-h-tap border border-[var(--lc-border-strong)] bg-[var(--lc-surface)] text-[var(--lc-text-primary)] hover:bg-[var(--lc-action-secondary)] hover:text-[var(--lc-action-secondary-text)] min-h-tap rounded-md px-3" type="button" disabled="">Next</button></div></footer></div></div></div></body></html>"
