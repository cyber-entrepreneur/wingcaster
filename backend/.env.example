# Copy to .env and fill in real values. Do not put secrets here.
# Shared frontend/backend template also lives at web/.env.example.

# --- REQUIRED ---
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3001

# --- SENTRY (error tracking) ---
# Backend DSN. Leave empty to disable (silent no-op with warn log).
SENTRY_DSN=
# Release identifier — CI should set from github.sha
GIT_SHA=

# Build-time only (used by web Vite plugin when building from monorepo CI):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=wingcaster
# SENTRY_PROJECT_WEB=wingcaster-web
